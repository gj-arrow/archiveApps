# Ключи провайдеров лежат в ai-config.php, и .htaccess прячет от HTTP весь класс
# по префиксу ^(ai-config|\.ai-config|#ai-config). Здесь — тот же класс и по той
# же причине, а не перечисление имён: перечисление разошлось с .htaccess, и
# именно такой разрыв уводит ключ в git. Три строки, а не одна, потому что
# .gitignore не умеет необязательную группу: ? означает ровно один символ, а
# фигурных скобок в синтаксисе нет. Ветка с решёткой экранирована — без
# обратного слэша строка с # в начале была бы комментарием.
ai-config*
\.ai-config*
\#ai-config*
# diag.php — служебный отладочный скрипт, в историю ему нельзя. Классом
# ключей он не является, поэтому вынесен отдельной строкой.
diag.php
