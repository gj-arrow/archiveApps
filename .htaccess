# Options -Indexes здесь намеренно нет. На шаред-хостинге директива Options
# часто запрещена в AllowOverride, и тогда она роняет в 500 весь сайт, а не
# только /ai/. Прироста в безопасности от неё ноль: единственный чувствительный
# файл закрыт отдельным блоком <Files> ниже, а запрет листинга директорий —
# текущее состояние сайта, которое эта задача не меняет.

# Отдаём только рабочие пути и healthz. Всё прочее под /ai/ — 404,
# чтобы прокси не превращался в открытый конверт для чужих запросов.
# Список путей и адресов в proxy.php ($engines) и правило здесь обязаны
# совпадать: забытый здесь путь даёт 404 от Apache, а не от прокси.
#
# Блок завёрнут в <IfModule mod_rewrite.c> намеренно: если модуль не загружен,
# Apache или LiteSpeed отвечает 500 на самой директиве RewriteEngine, и тогда
# ложится весь сайт, а не только /ai/. Внутри гварда директивы просто
# пропускаются, и сайт продолжает работать — прокси при этом не заработает,
# но это заметно и чинится одним включением модуля.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^ai/healthz$ proxy.php [L]
  # Отметка «локальный движок жив» шлёт ПК владельца при старте и по таймеру.
  RewriteRule ^ai/local-alive$ proxy.php [L]
  # Единая цепочка: один запрос, fallback local -> opencode -> openrouter
  # решает сам прокси. Отдельный путь local — для дебага приложения
  # (долгий тап по «Распознать»): только локалка, без фолбэка.
  RewriteRule ^ai/v1/chat/completions$ proxy.php [L]
  RewriteRule ^ai/local/v1/chat/completions$ proxy.php [L]
  RewriteRule ^ai/ - [R=404,L]
</IfModule>

# ai-config.php отдавать нельзя. Блок завёрнут в <IfModule> по модулю
# авторизации намеренно: Require all denied — директива Apache 2.4
# (mod_authz_core), и на LiteSpeed с 2.2-семантикой она даёт 500 на весь сайт,
# ровно тот сценарий, ради которого выше убраны Options -Indexes и обёрнут
# RewriteEngine. Запасной путь тоже под гвардом: Deny from all без
# mod_access_compat на 2.4 тоже неизвестен, а с ним — рабочий. Если модулей
# нет, блок просто пропускается: хуже, чем 500 на всё, и чинится включением
# модуля на хостинге.
#
# Перечисление расширений ловило бы выборочно, а не класс: ai-config.php.1,
# .bak2, .txt и настоящие временные файлы редакторов под него не попадают —
# vim даёт .ai-config.php.swp и #ai-config.php#, то есть с ведущей точкой или
# решёткой, а это ровно то, что делает временный файл. Плюс ai-config.php уже
# исполняется сервером и сам по себе отдаётся пустым, то есть опасна не он, а
# его копия. Поэтому шаблон префиксный и перекрывает весь класс: сам файл,
# вариант с ведущей точкой (прячем, скрытые файлы не отдаём) и emacs-вариант с
# решёткой. Листинг директорий на сайте включён, то есть копия и видна в
# списке, и скачивается — закрывать надо весь класс, а не выборочно.
<IfModule mod_authz_core.c>
  <FilesMatch "^(ai-config|\.ai-config|#ai-config)">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <IfModule mod_access_compat.c>
    <FilesMatch "^(ai-config|\.ai-config|#ai-config)">
      Order allow,deny
      Deny from all
    </FilesMatch>
  </IfModule>
</IfModule>
